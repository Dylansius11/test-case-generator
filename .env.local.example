# ──────────────────────────────────────────────────────────────────────────────
# AI Test Case Generator — Environment Variables
# Copy this file to .env.local and fill in your credentials.
# .env.local is git-ignored and must NEVER be committed.
# ──────────────────────────────────────────────────────────────────────────────

# ── IBM watsonx.ai (preferred for IBM hackathon) ──────────────────────────────
# Create a project at https://dataplatform.cloud.ibm.com/
# Generate an API key at https://cloud.ibm.com/iam/apikeys

WATSONX_API_KEY=your-ibm-cloud-api-key
WATSONX_PROJECT_ID=your-watsonx-project-id

# Regional endpoint — pick the one matching your IBM Cloud region
# us-south:  https://us-south.ml.cloud.ibm.com
# eu-de:     https://eu-de.ml.cloud.ibm.com
# eu-gb:     https://eu-gb.ml.cloud.ibm.com
# jp-tok:    https://jp-tok.ml.cloud.ibm.com
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# Model ID — granite or llama hosted on watsonx
# Options: meta-llama/llama-3-3-70b-instruct (default)
#          ibm/granite-13b-instruct-v2
#          mistralai/mistral-large
WATSONX_MODEL_ID=meta-llama/llama-3-3-70b-instruct


# ── OpenAI / compatible (fallback provider) ───────────────────────────────────
# Used automatically if WATSONX_API_KEY is NOT set.

OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# Override to point at any OpenAI-compatible endpoint (e.g. Azure, Groq, Together AI)
# OPENAI_BASE_URL=https://api.openai.com/v1


# ── Local development mock ────────────────────────────────────────────────────
# Set to "true" to skip ALL AI calls and return a hardcoded fixture response.
# Do NOT set this in production.

AI_MOCK=true
